{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "README.md",
      ".env*",
      "scripts/**",
      "node_modules/**",
      ".firebase/**",
      "*.pem",
      "*.key",
      "*service-account*.json",
      "*credentials*.json",
      ".git/**",
      ".gitignore",
      ".DS_Store"
    ],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
